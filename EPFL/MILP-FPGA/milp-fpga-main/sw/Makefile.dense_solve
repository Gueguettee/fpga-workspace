# DenseSolve FPGA testbench.
# Requires Xilinx CMA library — build and run on the Zynq board.
#
# Build: make -f Makefile.dense_solve
# Run:   sudo ./dense_solve_bench

CXX=g++
CXXFLAGS=-O2 -std=c++17 -Idrivers -Iinclude -I../shared -I/usr/local/include -Wall -Wextra
LDFLAGS=-lcma -lpthread -L/usr/local/lib -Wl,-rpath,/usr/local/lib -lpmt

SRC=src/denseSolveTestbench.cpp src/pmt_power_meter.cpp drivers/CAccelProxy.cpp drivers/CDenseSolveProxy.cpp
BIN=dense_solve_bench

all: $(BIN)

$(BIN): $(SRC)
	$(CXX) $(CXXFLAGS) -o $@ $(SRC) $(LDFLAGS)

clean:
	rm -f $(BIN)
